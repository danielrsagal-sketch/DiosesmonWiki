// Configuración del Worker de Cloudflare que publica la DiosesmonWiki.
// La web son archivos estáticos (la raíz del repositorio, menos lo que excluye .assetsignore);
// worker/index.js solo responde a /api/* (las Cazas actuales que se editan en admin.html).
// La contraseña de admin NO va aquí: es el secreto ADMIN_PASSWORD del panel (Settings → Variables and Secrets).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "diosesmonwiki",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    { "binding": "CAZAS_KV", "id": "8b02f6f223054ec39a5b82649c0753a7" }
  ]
}
